# Variables de PRODUCTION (à renseigner dans Vercel, NE PAS committer)
# Copiez ce fichier en .env.production puis : npx vercel env pull --environment production

DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"
# OBLIGATOIRE : sans lui, l'app refuse de démarrer en production
JWT_SECRET="<générer : node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\">"

MAX_UPLOAD_BYTES=2097152
MAX_IMAGES_PER_LISTING=5

NEXT_PUBLIC_SITE_URL="https://thiadiaye-shop.vercel.app"

# Paiements
PAYMENT_PROVIDER="cinetpay"
PAYMENT_MODE="production"
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""

# Emails (SMTP réel)
EMAIL_DRIVER="smtp"
EMAIL_FROM="THIADIAYE.SHOP <no-reply@thiadiaye.shop>"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# Stockage S3 (obligatoire sur Vercel : disque éphémère)
STORAGE_DRIVER="s3"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# URL publique (R2/Cloudflare) — si vide, l'app sert les images via /api/uploads
S3_PUBLIC_URL=""

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
NEXT_PUBLIC_ADSENSE_SLOT_HOME=""
NEXT_PUBLIC_ADSENSE_SLOT_LIST=""
NEXT_PUBLIC_ADSENSE_SLOT_DETAIL=""
