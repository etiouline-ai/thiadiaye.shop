# Copiez ce fichier en .env et adaptez les valeurs

DATABASE_URL="postgresql://thiadiaye:thiadiaye@localhost:5432/thiadiaye_shop?schema=public"

# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

MAX_UPLOAD_BYTES=2097152
MAX_IMAGES_PER_LISTING=5

# mock (développement) | cinetpay | paydunya
PAYMENT_PROVIDER="mock"
PAYMENT_MODE="sandbox"

CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""
# Optionnel : base API de test (ex: https://sandbox.cinetpay.com/v2)
CINETPAY_BASE_URL=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google AdSense (laisser vide pour désactiver) — ex: ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
NEXT_PUBLIC_ADSENSE_SLOT_HOME=""
NEXT_PUBLIC_ADSENSE_SLOT_LIST=""
NEXT_PUBLIC_ADSENSE_SLOT_DETAIL=""

# Emails : log (défaut, écrit dans data/emails/) | smtp
EMAIL_DRIVER="log"
EMAIL_FROM="THIADIAYE.SHOP <no-reply@thiadiaye.shop>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Stockage des images : local (défaut) | s3 (production, compatible R2/MinIO/Backblaze)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# URL publique des images (CDN/R2) — si vide, l'app les sert via /api/uploads
S3_PUBLIC_URL=""
